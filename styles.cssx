*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{
  margin:0;
  font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;
  background:#f5f7fb;
  color:#172033;
  padding-bottom:70px;
}

/* ========== AUTH / LOGIN SCREEN ========== */
.auth-screen{
  position:fixed;
  inset:0;
  background:#101827;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:20px;
  z-index:200;
}
.auth-card{
  background:#fff;
  width:100%;
  max-width:400px;
  border-radius:16px;
  padding:28px 22px;
  box-shadow:0 10px 40px rgba(0,0,0,.3);
}
.auth-card .brand{
  font-size:26px;
  font-weight:900;
}
.auth-card .brand span{
  font-size:12px;
  background:#101827;
  color:#fff;
  padding:3px 6px;
  border-radius:5px;
  margin-left:5px;
}

/* ========== SIDEBAR ========== */
.sidebar{
  position:fixed;left:0;top:0;bottom:0;
  width:245px;
  background:#101827;color:#fff;
  padding:25px 18px;
  display:flex;flex-direction:column;
  z-index:10;
}
.brand{font-size:23px;font-weight:900;letter-spacing:.5px}
.brand span{
  font-size:11px;background:#fff;color:#101827;
  padding:3px 5px;border-radius:5px;margin-left:5px
}
.tagline{color:#9eabc0;font-size:12px;margin:4px 0 28px}
.nav-item{
  border:0;background:transparent;color:#bdc7d8;
  width:100%;padding:12px 13px;border-radius:10px;
  text-align:left;margin:2px 0;cursor:pointer;font-size:14px
}
.nav-item:hover,.nav-item.active{background:#243149;color:#fff}
.sidebar-footer{margin-top:auto;color:#74829a;font-size:11px;line-height:1.6}

/* ========== MAIN ========== */
.main{margin-left:245px;padding:30px;max-width:1500px}
.topbar{
  display:flex;justify-content:space-between;gap:20px;
  align-items:center;margin-bottom:25px
}
.topbar h1{margin:0 0 5px;font-size:29px}
.topbar p{margin:0;color:#68758a;font-size:14px}
.ai-btn{
  border:0;background:#111c2e;color:#fff;
  padding:12px 17px;border-radius:10px;
  cursor:pointer;font-weight:700;white-space:nowrap
}

/* ========== CARDS & GRIDS ========== */
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.card{
  background:#fff;border:1px solid #e5e9f1;
  border-radius:14px;padding:19px;
  box-shadow:0 4px 15px rgba(20,35,60,.04)
}
.metric{font-size:28px;font-weight:800;margin:8px 0}
.muted{color:#758197;font-size:13px}
.section{margin-top:22px}
.section h2{font-size:18px;margin:0 0 12px}
.service{cursor:pointer;transition:.15s}
.service:hover{transform:translateY(-2px);box-shadow:0 7px 20px rgba(20,35,60,.08)}
.icon{font-size:27px}

/* ========== BUTTONS ========== */
.btn{
  border:0;border-radius:9px;padding:10px 14px;
  background:#172033;color:white;cursor:pointer;font-weight:700
}
.btn.secondary{background:#edf1f7;color:#172033}
.btn.success{background:#176b4d}
.btn.warn{background:#9a5b12}
.row{display:flex;justify-content:space-between;align-items:center;gap:12px}

/* ========== MAP ========== */
.map{
  height:300px;border-radius:14px;
  background:linear-gradient(135deg,#dfe9dd,#eaf0f7);
  position:relative;overflow:hidden;border:1px solid #d7dfeb
}
.road{
  position:absolute;background:#fff;height:12px;
  transform:rotate(-24deg);left:-10%;right:-10%;top:48%;
  box-shadow:0 0 0 2px #d3dbe6
}
.route{
  position:absolute;width:70%;height:5px;background:#172033;
  left:14%;top:50%;transform:rotate(-24deg);border-radius:5px
}
.pin{position:absolute;font-size:27px}
.pin.a{left:17%;top:62%}
.pin.b{right:18%;top:24%}
.trip-box{
  position:absolute;bottom:14px;left:14px;
  background:#fff;padding:10px 13px;border-radius:10px;
  box-shadow:0 4px 12px #0002
}

/* ========== TABLE & BADGE ========== */
.table{width:100%;border-collapse:collapse}
.table th,.table td{
  padding:12px 9px;border-bottom:1px solid #edf0f5;
  text-align:left;font-size:13px
}
.badge{
  display:inline-block;padding:4px 8px;border-radius:20px;
  background:#e8f6ef;color:#176b4d;font-size:11px;font-weight:700
}
.badge.gray{background:#eef1f5;color:#637086}
.badge.orange{background:#fff1dc;color:#9a5b12}

/* ========== MODAL ========== */
.modal{
  position:fixed;inset:0;background:#0008;
  display:flex;align-items:center;justify-content:center;
  padding:20px;z-index:100
}
.hidden{display:none}
.modal-card{
  background:#fff;width:min(620px,100%);
  border-radius:16px;padding:24px;position:relative;
  max-height:90vh;overflow-y:auto
}
.close{
  position:absolute;right:14px;top:10px;border:0;
  background:transparent;font-size:27px;cursor:pointer
}
.input{
  width:100%;padding:11px;border:1px solid #d8deea;
  border-radius:8px;margin:7px 0 13px;font-size:16px
}

/* ========== CHAT ========== */
.chat{
  height:270px;overflow:auto;background:#f6f8fb;
  border-radius:10px;padding:12px
}
.msg{
  padding:9px 12px;border-radius:12px;margin:7px 0;
  max-width:78%;background:#e7ebf2
}
.msg.me{margin-left:auto;background:#172033;color:#fff}

/* ========== BOTTOM NAV ========== */
.bottom-nav{
  display:none;
  position:fixed;bottom:0;left:0;right:0;
  background:#101827;
  padding:8px 4px calc(8px + env(safe-area-inset-bottom));
  z-index:50;
  box-shadow:0 -4px 20px rgba(0,0,0,.15)
}
.bottom-nav-item{
  flex:1;display:flex;flex-direction:column;align-items:center;
  justify-content:center;gap:3px;
  background:transparent;border:0;color:#9eabc0;
  font-size:10px;padding:6px 2px;cursor:pointer;
  border-radius:10px
}
.bottom-nav-item.active{color:#fff;background:#243149}
.bottom-nav-item .icon{font-size:20px;line-height:1}

/* ========== RESPONSIVE ========== */
@media(max-width:1000px){
  .sidebar{width:190px}
  .main{margin-left:190px}
  .grid{grid-template-columns:repeat(2,1fr)}
  .cards,.grid-3{grid-template-columns:1fr 1fr}
}

@media(max-width:700px){
  body{padding-bottom:75px}
  .sidebar{display:none}
  .main{margin-left:0;padding:16px 14px 20px}
  .topbar{
    align-items:flex-start;flex-direction:column;gap:12px;
    margin-bottom:18px
  }
  .topbar h1{font-size:22px}
  .ai-btn{width:100%;text-align:center;padding:13px}
  .grid,.cards,.grid-3{grid-template-columns:1fr;gap:12px}
  .card{padding:16px}
  .metric{font-size:24px}
  .map{height:240px}
  .bottom-nav{display:flex}
  .sidebar-footer{display:none}
  .modal-card{padding:20px 16px;border-radius:14px 14px 0 0;margin-top:auto}
  .modal{align-items:flex-end;padding:0}
}

@media(max-width:380px){
  .bottom-nav-item{font-size:9px}
  .bottom-nav-item .icon{font-size:18px}
}
